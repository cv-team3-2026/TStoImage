# 이 파일을 복사해 이름을 secrets.env 로 바꾼 뒤 값을 채운다.
#   - secrets.env 는 .gitignore 에 들어 있어 GitHub 에 올라가지 않는다.
#   - 이 예시 파일(secrets.example.env)에는 실제 값을 적지 않는다. 이 파일은 GitHub 에 올라간다.
#   - key 를 코드, yaml, 노트북 셀에 직접 적지 않는다.
#   - Colab 에서는 이 파일 대신 왼쪽 열쇠 아이콘(Secrets)에 같은 이름으로 넣어도 된다.
# 쓰지 않는 항목은 비워 둔다. 점검: python -m ts2img doctor

# HuggingFace (공개 모델과 데이터만 쓰면 필요 없다)
HF_TOKEN=

# 외부 VLM 서버 (models.yaml 의 lab-vlm)
LAB_VLM_BASE_URL=
LAB_VLM_API_KEY=

# 유료 API (쓰는 것만)
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
